# Supabase (shared project, RLS-scoped to adel tenant)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Platform comprehension default (nuance-first).
# PLATFORM_PROVIDER: openai | anthropic | google | deepseek | mistral
# gpt-4o  = best speed/quality balance (~3s per comprehension)
# gpt-5   = highest nuance, but a REASONING model (~12s per comprehension)
PLATFORM_PROVIDER=openai
PLATFORM_MODEL=gpt-4o

# Provider keys — platform keys are used when the user has no BYOK connection.
# Add the key(s) you obtain here (and mirror them into Vercel env for production).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
# Operator console (/admin). Comma-separated emails allowed to see cost and
# issue invitations. Everyone else is redirected to the library.
ADMIN_EMAILS=
